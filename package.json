{
  "name": "echocue",
  "version": "0.1.0",
  "description": "Echocue - AI-powered live streaming assistant",
  "main": "dist/main/index.cjs",
  "type": "module",
  "workspaces": [
    "src/contracts"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\"",
    "dev:main": "vite build --config vite.config.main.ts --watch --mode development",
    "dev:preload": "vite build --config vite.config.preload.ts --watch --mode development",
    "dev:renderer": "vite --config vite.config.renderer.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config vite.config.main.ts",
    "build:preload": "vite build --config vite.config.preload.ts",
    "build:renderer": "vite build --config vite.config.renderer.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "tsx src/contracts/test/schemas.test.ts",
    "test:all": "npm run test:contracts && npm run test",
    "benchmark:safety-routing": "tsx scripts/run-safety-routing-benchmark.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "start": "electron .",
    "preview": "npm run build && npm run start",
    "license:scan": "license-checker --json --out dist/compliance/licenses.json",
    "license:check": "node scripts/license-check.js",
    "sbom": "cyclonedx-npm --ignore-npm-errors --output-format json --output-file dist/compliance/sbom.cdx.json",
    "compliance": "npm run license:check && npm run sbom"
  },
  "keywords": [
    "electron",
    "live-streaming",
    "ai-assistant"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@echocue/contracts": "*",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.57.2",
    "@opentelemetry/sdk-metrics": "1.30.1",
    "@opentelemetry/sdk-node": "0.57.2",
    "@qdrant/js-client-rest": "1.19.0",
    "ajv": "8.10.0",
    "electron": "33.4.11",
    "jieba-wasm": "2.4.0",
    "murmurhash3js-revisited": "3.0.0",
    "prom-client": "15.1.3",
    "ws": "8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@types/murmurhash3js-revisited": "3.0.3",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/ui": "2.1.9",
    "concurrently": "9.2.4",
    "electron-builder": "25.1.8",
    "license-checker": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-electron": "0.28.8",
    "vitest": "2.1.9"
  }
}