{
  "name": "echocue",
  "version": "0.1.0",
  "description": "Echocue - AI-powered live streaming assistant",
  "main": "dist/main/index.js",
  "type": "module",
  "workspaces": [
    "src/contracts"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\"",
    "dev:main": "vite build --config vite.config.main.ts --watch --mode development",
    "dev:preload": "vite build --config vite.config.preload.ts --watch --mode development",
    "dev:renderer": "vite --config vite.config.renderer.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config vite.config.main.ts",
    "build:preload": "vite build --config vite.config.preload.ts",
    "build:renderer": "vite build --config vite.config.renderer.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "tsx src/contracts/test/schemas.test.ts",
    "test:all": "npm run test:contracts && npm run test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "start": "electron .",
    "preview": "npm run build && npm run start"
  },
  "keywords": [
    "electron",
    "live-streaming",
    "ai-assistant"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@echocue/contracts": "*",
    "electron": "^33.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "concurrently": "^9.1.2",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vitest": "^2.1.9"
  }
}
