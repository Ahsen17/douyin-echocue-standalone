{
  "name": "echocue",
  "version": "0.1.0",
  "description": "Echocue - AI-powered live streaming assistant",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\"",
    "dev:main": "vite build --config vite.config.main.ts --watch --mode development",
    "dev:preload": "vite build --config vite.config.preload.ts --watch --mode development",
    "dev:renderer": "vite --config vite.config.renderer.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config vite.config.main.ts",
    "build:preload": "vite build --config vite.config.preload.ts",
    "build:renderer": "vite build --config vite.config.renderer.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "start": "electron .",
    "preview": "npm run build && npm run start"
  },
  "keywords": [
    "electron",
    "live-streaming",
    "ai-assistant"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "electron": "^33.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8"
  }
}
