{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echocue.local/schema/pre-set-v1.schema.json",
  "title": "Echocue pre_set line v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "text", "semantic_type", "description", "enabled", "is_bad_case"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^pre-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 200 },
    "semantic_type": {
      "enum": ["persona_relevant", "positive_praise", "funny_joke", "interactive_question", "atmosphere_boost", "low_value", "filter_risk"]
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "reference_reply": { "type": "string", "minLength": 1, "maxLength": 80 },
    "reference_cues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 24 }
    },
    "enabled": { "type": "boolean" },
    "is_bad_case": { "const": false }
  }
}
